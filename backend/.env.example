# Copy to .env for local development. In production (Render), set these as
# environment variables in the dashboard instead — never commit a real .env file.

# Firebase Admin SDK service account for the koorazone-e59a7 project.
# Firebase Console > koorazone-e59a7 > Project Settings > Service Accounts >
# Generate new private key. Paste the full JSON, or its base64 encoding
# (base64 is more reliable — see firebase-admin.js for why).
FIREBASE_SERVICE_ACCOUNT=

# API-Football (api-football.com / API-SPORTS) key — free tier dashboard,
# not the RapidAPI marketplace. See README.md for the signup steps.
FOOTBALL_API_KEY=

# Leagues to track for top scorers, as "id:Name" pairs separated by
# commas. Find ids at https://www.api-football.com/documentation-v3#tag/Leagues
# Defaults to Premier League + LaLiga.
FOOTBALL_LEAGUES=39:Premier League,140:LaLiga

# Season year (defaults to the current year if unset).
FOOTBALL_SEASON=2025

# How often to poll top scorers (hours). Live scores/standings are fetched
# client-side from worldcup26.ir instead — see football_theme.xml.
STANDINGS_POLL_HOURS=6

# Optional shared secret required as ?token=... on the manual /refresh-scorers route.
REFRESH_TOKEN=

PORT=3001
